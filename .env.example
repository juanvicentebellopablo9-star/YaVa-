# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# MAPS_API_KEY: Required for Google Maps SDK and Google Maps Compose.
# Users configure this via the Secrets panel in AI Studio.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# SLACK_WEBHOOK_URL: Required for Slack operations team alerts on order status changes.
# Get it from Slack > Apps > Incoming Webhooks (your-workspace.slack.com/services/new/incoming-webhook).
# Create a webhook for the #operaciones channel and paste the URL here.
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL
