# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# MAPS_API_KEY: Required for Google Maps SDK and Google Maps Compose.
# Users configure this via the Secrets panel in AI Studio.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# SLACK_WEBHOOK_URL: Required for Slack operations team alerts on order status changes.
# Get it from Slack > Apps > Incoming Webhooks (your-workspace.slack.com/services/new/incoming-webhook).
# Create a webhook for the #operaciones channel and paste the URL here.
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL

# FIREBASE_PROJECT_ID: Your Firebase project ID from the Firebase Console.
# Get it from console.firebase.google.com > Project Settings > General.
FIREBASE_PROJECT_ID=yava-logistics

# FIREBASE_API_KEY: Web API key for your Firebase project.
# Get it from console.firebase.google.com > Project Settings > General > Web API Key.
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY

# FIREBASE_APP_ID: Firebase Android App ID.
# Get it from console.firebase.google.com > Project Settings > General > Your apps > App ID.
FIREBASE_APP_ID=com.aistudio.yava.logistics

# STORE_PASSWORD: Password for the release keystore (my-upload-key.jks).
# Used for both store and key (PKCS12 format uses a single password).
# Generated automatically by Base44; replace with your own for production distribution.
STORE_PASSWORD=YOUR_STORE_PASSWORD

# KEY_PASSWORD: Optional override for the key password. If not set, STORE_PASSWORD is used.
KEY_PASSWORD=YOUR_KEY_PASSWORD
